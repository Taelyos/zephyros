// The configuration of OpenCode in a Zephyros instance (ADR 0029), in its managed scope.
// {env:NAME} is replaced by OpenCode with the environment of the turn, which the container
// filter sets: the hub's agent endpoint, the model name and the project token, the one secret,
// and those the entrypoint sets.
// The model gateway and the MCP server of the hub are at the same address, which the network
// guard lets through at every level (ADR 0024).
{
  "$schema": "https://opencode.ai/config.json",
  // The model: the one the gateway serves, through the gateway alone. The provider key stays in
  // the hub; OpenCode authenticates with the project token, and the hub counts every call
  // against the instance that made it.
  "enabled_providers": ["zephyros"],
  "model": "zephyros/{env:ZEPHYROS_MODEL}",
  "small_model": "zephyros/{env:ZEPHYROS_MODEL}",
  "provider": {
    "zephyros": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Zephyros model gateway",
      "options": {
        "baseURL": "{env:ZEPHYROS_HUB_URL}/v1",
        "apiKey": "{env:ZEPHYROS_TOKEN}",
        // The gateway answers once the provider has answered whole (gateway.timeout_seconds,
        // 3600 s at most), so the headers of a long answer come late. OpenCode would give up
        // after 300 s and ask again, and the provider would be paid twice: the gateway's
        // limit is the one that holds, these wait one minute longer.
        "headerTimeout": 3660000,
        "chunkTimeout": 3660000
      },
      "models": {
        "{env:ZEPHYROS_MODEL}": {
          "name": "{env:ZEPHYROS_MODEL}",
          "tool_call": true,
          // Keep the reasoning of each answer in the conversation sent again when the model
          // wants it back, whatever its name behind the gateway (ADR 0032): the entrypoint
          // makes this "reasoning_content", the field the gateway carries, or empty, which
          // keeps nothing. OpenCode would otherwise decide from the name.
          "interleaved": "{env:ZEPHYROS_REASONING_FIELD}",
          // The window of the model, as the operator declares it, and the input limit from
          // which OpenCode compacts, less the 16 000 tokens it keeps for the answer: the
          // entrypoint sets it so that OpenCode compacts where Hermes does (ADR 0033).
          "limit": {
            "context": {env:ZEPHYROS_CONTEXT_WINDOW},
            "input": {env:ZEPHYROS_OPENCODE_INPUT},
            "output": 16000
          }
        }
      }
    }
  },
  // The hub's tools, with the project token, and no other MCP server.
  "mcp": {
    "zephyros": {
      "type": "remote",
      "url": "{env:ZEPHYROS_HUB_URL}/mcp",
      "enabled": true,
      "oauth": false,
      "headers": { "Authorization": "Bearer {env:ZEPHYROS_TOKEN}" }
    }
  },
  // Every tool is allowed without a question, which a turn could not answer: the agent acts
  // inside its container only, and what the container reaches is the guard's and the hub's
  // decision, not this one.
  "permission": "allow",
  "share": "disabled",
  "autoupdate": false,
  "snapshot": false,
  "lsp": false,
  "formatter": false,
  "plugin": [],
  "compaction": { "auto": true }
}
